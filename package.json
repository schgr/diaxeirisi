{
  "name": "diaxeirisi-ylikoy",
  "version": "0.13.239",
  "description": "Offline-first Windows desktop prototype for service and financial management.",
  "author": "Λγος (ΦΠΒ) Αλεξανδρής Ιωάννης",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pretest": "node scripts/check-orphan-modules.js",
    "check": "node --check src/main.js && node --check src/preload.js",
    "test": "node scripts/run-tests.js",
    "benchmark": "node benchmarks/performanceBenchmark.mjs",
    "benchmark:persistence": "node benchmarks/persistenceMutationBenchmark.mjs",
    "benchmark:share-print": "node benchmarks/sharePrintBatchBenchmark.mjs",
    "benchmark:share-ui": "node benchmarks/shareUiResponsivenessBenchmark.mjs",
    "benchmark:workers": "node benchmarks/workerPoolBenchmark.mjs",
    "benchmark:offline": "node benchmarks/offlinePolicyBenchmark.mjs",
    "pack:source": "node scripts/pack-source.js",
    "build": "npm run dist:win",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:win:x86": "electron-builder --config electron-builder.win-x86.json --win nsis --ia32",
    "dist:win7": "electron-builder --config electron-builder.win7.json --win nsis --x64",
    "dist:win7:x86": "electron-builder --config electron-builder.win7-x86.json --win nsis --ia32",
    "dist:win:stable": "electron-builder --win nsis --x64",
    "dist:win:beta": "electron-builder --config electron-builder.beta.js --win nsis --x64",
    "dist:win:all": "npm run dist:win:stable && npm run dist:win:beta"
  },
  "build": {
    "appId": "gr.local.diaxeirisi.ylikoy",
    "productName": "diaxeirisi Ylikoy",
    "icon": "build/icon.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "!src/**/*-TECLAST.js",
      "!src/types/**/*",
      "!src/exhpForm/supportingDocs/shared/docHeader.js",
      "!src/exhpForm/supportingDocs/shared/letteredList.js",
      "!node_modules/**/*.codexbak",
      "build/icon.ico",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "diaxeirisi Ylikoy",
      "include": "build/installer.nsh",
      "artifactName": "diaxeirisi-Ylikoy-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "sql.js": "^1.12.0",
    "uuid": "^11.1.1"
  },
  "overrides": {
    "tmp": "^0.2.6",
    "readable-stream": "3.6.2",
    "lazystream": {
      "readable-stream": "1.1.14"
    }
  },
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^26.0.12"
  }
}
